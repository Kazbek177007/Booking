#include <QDateTime>

class Cart
{
    PROP(QMap<int, int> items);

    SLOT(void addItem(int id));
    SLOT(void removeItem(int id));
    SLOT(void clear());
};

class UserProfile 
{
    PROP(QString name);
    PROP(QString lastName);
    PROP(QString email)
    PROP(QString phoneNumber);
};

POD Order(QMap<int, int> items, QDateTime dateTime)

class OrderHistory
{
    PROP(QList<Order> orders)
    SLOT(void createOrder(QMap<int, int> items))
};


